# Copy to `.env` in this folder — same keys as ShowBK where possible (PayPal, JWT). Email uses MailerSend.
# Do not commit real secrets.

# --- Postgres (optional overrides for docker-compose; defaults match SimplePriceTracker) ---
POSTGRES_USER=pricetracker
POSTGRES_PASSWORD=pricetracker
POSTGRES_DB=pricetracker

# If set, overrides the API container DATABASE_URL (use host `postgres` inside Compose)
# DATABASE_URL=postgresql://pricetracker:pricetracker@postgres:5432/pricetracker?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_SEC=604800

# PayPal (same names as ShowBK packages/core)
PAYPAL_USE_SANDBOX=true
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PRO_PLAN_ID=

# MailerSend (API token from dashboard → API tokens)
MAILERSEND_API_KEY=
EMAIL_FROM=
MAIL_FROM=

# Browser origins (comma-separated; same list as backend/.env.example).
CORS_ORIGIN=http://localhost:4200,http://localhost:8080,http://localhost,http://127.0.0.1
# Production example: CORS_ORIGIN=https://pricefly.reikalabs.com
# UI_URL=https://your-domain.com

# Umami (baked into the web image at build time — add website in Umami UI, then rebuild `web`)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# --- TLS (docker-compose.ssl.yml + edge / certbot — same pattern as ShowBK) ---
# CI deploy merges these from GitHub repository secrets (same names) into server .env if you use Actions.
# Primary hostname (first -d for certbot; certificate path live/<SSL_PRIMARY_DOMAIN>/)
# SSL_PRIMARY_DOMAIN=pricefly.reikalabs.com
# LETSENCRYPT_EMAIL=you@example.com
# Optional extra SANs (space-separated): SSL_EXTRA_DOMAINS=umami.reikalabs.com
# SSL_EXTRA_DOMAINS=
