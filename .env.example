# Copy to `.env` in this folder — same keys as ShowBK where possible (PayPal, JWT). Email uses Brevo.
# Do not commit real secrets.

# --- Postgres (optional overrides for docker-compose; defaults match SimplePriceTracker) ---
POSTGRES_USER=pricetracker
POSTGRES_PASSWORD=pricetracker
POSTGRES_DB=pricetracker

# If set, overrides the API container DATABASE_URL (use host `postgres` inside Compose)
# DATABASE_URL=postgresql://pricetracker:pricetracker@postgres:5432/pricetracker?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_SEC=604800

# PayPal (same names as ShowBK packages/core). Client ID is baked into the web image at docker compose build.
PAYPAL_USE_SANDBOX=true
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Plan id for API seed; seed sets Pro row (399¢/mo net = 3.99 €, VAT copy in app). PayPal product must match monthly billing.
PAYPAL_PRO_PLAN_ID=P-6TL7122718514241MNHCG5QQ

# Brevo (Settings → SMTP & API → API keys)
# Public web app URL for e-mail verification links (no trailing slash)
APP_PUBLIC_URL=https://pricefly.reikalabs.com
SKIP_EMAIL_VERIFICATION=false
BREVO_API_KEY=
# false = Brevo only for welcome e-mail; true = also price-alert e-mails (omit = same as true for older configs)
SEND_PRICE_ALERT_EMAILS=false
EMAIL_FROM=
MAIL_FROM=
# MailerSend (optional archive only; app uses Brevo)
# MAILERSEND_API_KEY=

# Public URL of your imprint / legal notice (https…). Used in the User-Agent for Steam Store API requests.
# Example: https://pricefly.example.com/imprint
PUBLIC_IMPRESSUM_URL=

# Web Push (VAPID) — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# Browser origins (comma-separated; same list as backend/.env.example).
CORS_ORIGIN=http://localhost:4200,http://localhost:8080,http://localhost,http://127.0.0.1
# Production example: CORS_ORIGIN=https://pricefly.reikalabs.com
# UI_URL=https://your-domain.com

# Umami (baked into the web image at build time — add website in Umami UI, then rebuild `web`)
# The tracker can point at any reachable host (same server or another); set domain in Umami to your app URL.
# Default host (ShowBK): https://umami.showbk.com — script URL is typically https://umami.showbk.com/script.js
UMAMI_HOST_URL=https://umami.showbk.com
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=8ef58fb8-8291-40c4-904c-77850d9558fa

# --- TLS (docker-compose.ssl.yml + edge / certbot — same pattern as ShowBK) ---
# CI deploy merges these from GitHub repository secrets (same names) into server .env if you use Actions.
# Primary hostname (first -d for certbot; certificate path live/<SSL_PRIMARY_DOMAIN>/)
# SSL_PRIMARY_DOMAIN=pricefly.reikalabs.com
# LETSENCRYPT_EMAIL=you@example.com
# Optional extra SANs (space-separated): SSL_EXTRA_DOMAINS=umami.reikalabs.com
# SSL_EXTRA_DOMAINS=
