# =============================================================================
# You do NOT need `docker compose` for the API + Angular if Postgres is running.
#
# Option A — only start the database in Docker (from repo root):
#   docker compose up -d postgres
# Option B — Postgres installed on Windows (localhost) with a user/db matching DATABASE_URL.
#
# Then: copy this file to `.env`, run `npx prisma migrate dev` + `npm run prisma:seed`,
# and start the app from the repo root with `npm start` (API :3000, Angular :4200).
# =============================================================================

# --- Price scheduler (Nest @nestjs/schedule) ---
# false = disable automatic once-daily catalog refresh for all users. Manual per-product refresh in the app still works.
PRICE_SCHEDULER_ENABLED=true

# --- Database (Prisma) ---
# • Docker DB only (`docker compose up -d postgres`): use the HOST port from docker-compose.yml
#   (e.g. `5460:5432` → connect with `localhost:5460`, not 5432).
# • Native Postgres on your machine: use its real port (often 5432) and matching user/password/db.
# • Full-stack Docker API container: DATABASE_URL uses host `postgres` and port 5432 inside the network.
DATABASE_URL="postgresql://pricetracker:pricetracker@127.0.0.1:5460/pricetracker?schema=public"

# --- Awin product catalog (no shop scraping) ---
# Export a camera/tech (or niche) product feed from Awin, then load it into Postgres:
#   AWIN_FEED_CSV_PATH=./fixtures/awin-sample.csv npm run import-awin-feed
# Re-run after each feed update so prices and deep links stay current.
# For multiple advertisers with auto-download:
#   1) copy backend/config/awin-feeds.example.json -> backend/config/awin-feeds.json
#   2) set real feed URLs in that file
#   3) npm run sync-awin-feeds
AWIN_FEEDS_CONFIG_PATH=./config/awin-feeds.json
AWIN_FEEDS_STORAGE_DIR=./data/awin
# Catalog text search: 0.15–0.5 (default 0.28). Lower = more typo-tolerant, more noise.
AWIN_CATALOG_FUZZY_MIN_SIM=0.28

# --- Auth (same idea as ShowBK core JWT) ---
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_SEC="604800"

# --- PayPal (same variable names as ShowBK packages/core) ---
# Use sandbox while testing; set PAYPAL_USE_SANDBOX=false for live.
PAYPAL_USE_SANDBOX=true
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Subscription plan ID from PayPal Dashboard (seeded into DB via PAYPAL_PRO_PLAN_ID / prisma seed).
# Seed sets Pro list price: 399 = €3.99/month net; VAT copy in app i18n (+19% USt). Use a monthly PayPal billing plan.
PAYPAL_PRO_PLAN_ID=P-6TL7122718514241MNHCG5QQ

# --- Public URL of the Angular app (no trailing slash). REQUIRED for correct links in verification e-mails.
# Production / Docker: set to your real site, e.g. https://pricefly.reikalabs.com
# If omitted, the API uses SSL_PRIMARY_DOMAIN (see docker-compose / TLS) as https://<domain>, else first non-localhost CORS origin.
# Local ng serve: http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200
# Optional: hostname only (e.g. pricefly.reikalabs.com). Docker Compose passes this from .env; verification links use https://<this> when APP_PUBLIC_URL is unset.
SSL_PRIMARY_DOMAIN=pricefly.reikalabs.com
# Dev only: set true to skip double opt-in and send no verification e-mail (auto-verify on register).
SKIP_EMAIL_VERIFICATION=false

# --- Brevo (https://www.brevo.com/) — Settings → SMTP & API → API keys (v3 key) ---
# Must be allowed to send transactional e-mails. Sender below must be a verified sender in Brevo.
# In production, registration requires BREVO_API_KEY (verification e-mail).
BREVO_API_KEY=
# Transactional mail: welcome on sign-up always (when key is set). Price-alert e-mails only if true (default if omitted: on).
# Set false while you only want sign-up mail from Brevo.
SEND_PRICE_ALERT_EMAILS=false
# Preferred: "Pricefly <noreply@reikalabs.com>" (must match verified sender/domain in Brevo — not mail.showbk.com)
EMAIL_FROM=
# Fallback if you only set this (older SimplePriceTracker name)
MAIL_FROM=

# --- MailerSend (archived — not used; see src/mail/mailersend-transactional.reference.ts) ---
# MAILERSEND_API_KEY=

# --- CORS (origins allowed to call the API from the browser) ---
# For `npm start` / `ng serve` you MUST include http://localhost:4200 (see Quick start above).
# Include :8080 only if you use the Docker `web` container (nginx) to open the UI.
# Production (single origin): https://pricefly.reikalabs.com
CORS_ORIGIN=http://localhost:4200,http://localhost:8080,http://localhost,http://127.0.0.1

# Optional (not read by the API yet): public site URL for your own docs
# UI_URL=https://your-domain.com

# --- Web Push (VAPID) — system notifications on Android / desktop when price alerts fire ---
# Generate keys: `npx web-push generate-vapid-keys`
VAPID_SUBJECT is a mailto: or https: contact URI (required by the Web Push spec).
VAPID_PUBLIC_KEY=BPQWAMxhGdQT3c1p9oahv0du7o5g8kWK9Vq5sP9KUXun-R_K8GE130ayR_vhMEOCaO0mPYj-BFj9i7eYuIQKrck
VAPID_PRIVATE_KEY=WgnULfTmY-oQ9y9ONjTQOBePNyYJckYEUk5Ae7EHJlk
VAPID_SUBJECT=mailto:you@example.com

# --- Demo price API (POST /trackings/demo, POST /trackings/:id/demo-price) ---
# Enabled automatically when NODE_ENV is not production. In production, set to true only if you
# intentionally want the demo endpoints (otherwise they return 403).
# ENABLE_DEMO_PRICE=true
