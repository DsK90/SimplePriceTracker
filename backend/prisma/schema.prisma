// Prisma 7: connection URL is in prisma.config.ts (see `defineConfig` datasource).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String
  planTier             PlanTier           @default(FREE)
  paypalSubscriptionId String?            @unique
  /// Set on registration when the user accepts the Terms of Service (AGB).
  termsAcceptedAt      DateTime?
  /// Double opt-in: set when the user confirms the verification link (e-mail ownership).
  emailVerifiedAt            DateTime?
  /// SHA-256 hex of the raw token sent by e-mail; cleared after successful verification.
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  /// Last time a confirmation e-mail was sent (sign-up or resend); used for resend cooldown.
  emailVerificationLastSentAt DateTime?
  /// Count of confirmation e-mails sent while unverified (sign-up + resends); reset when verified. Capped server-side.
  emailVerificationEmailsSent Int @default(0)
  /// UI / transactional mail language (e.g. `de`, `en`); set at registration, used for verification & welcome e-mails.
  preferredLocale      String?
  /// IANA timezone for the daily price check (e.g. Europe/Berlin).
  dailyCheckTimeZone   String             @default("Europe/Berlin")
  /// Local wall time HH:mm (24h) when all catalog trackings are refreshed once per day.
  dailyCheckLocalTime  String             @default("08:00")
  /// Local calendar date (YYYY-MM-DD in `dailyCheckTimeZone`) when the last automated daily run completed.
  dailyCheckLastRunDate String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  trackings            PriceTracking[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
}

/// Web Push subscription (VAPID) — one row per browser/device endpoint.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Published pricing / PayPal subscription product (seeded + configurable via env)
/// Normalized row from an Awin publisher product feed (CSV). Prices refresh from here — no shop scraping.
model AwinCatalogProduct {
  id                 String   @id @default(uuid())
  /// Stable key, usually `advertiser_id:aw_product_id` from the Awin feed
  feedKey            String   @unique
  advertiserId       String?
  advertiserName     String?
  title              String
  description        String?  @db.Text
  price              Decimal  @db.Decimal(12, 4)
  currency           String   @default("EUR")
  merchantDeepLink   String   @db.Text
  imageUrl           String?  @db.Text
  category           String?
  brand              String?
  updatedFromFeedAt  DateTime @default(now()) @updatedAt

  @@index([title])
}

model Plan {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  /// Price in cents per billing period (e.g. monthly net before VAT; UI adds VAT note)
  priceCents   Int
  currency     String  @default("EUR")
  paypalPlanId String
  /// null = unlimited trackings
  maxTrackings Int?
  sortOrder    Int     @default(0)
}

model PriceTracking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When set, price checks use `AwinCatalogProduct` only (no HTML scraping).
  awinFeedKey   String?
  url           String
  /// Scraped product name (refreshed with price)
  productName   String
  /// Store / brand / site name when detectable
  companyName   String?
  /// User-facing label; when set, shown instead of scraped productName
  productNameOverride   String?
  /// User-facing label; when set, shown instead of scraped companyName
  companyNameOverride   String?
  /// Notify once when price crosses down to this level or below (optional)
  alertBelowPrice Decimal? @db.Decimal(12, 4)
  /// Notify once when price crosses up to this level or above (optional)
  alertAbovePrice Decimal? @db.Decimal(12, 4)
  /// Email for price alerts on this product (plan-limited: 2 free, 10 Pro). Push + in-app stay unlimited.
  emailAlertsEnabled Boolean @default(false)
  lastPrice     Decimal? @db.Decimal(12, 4)
  currency      String   @default("EUR")
  lastCheckedAt DateTime?
  active        Boolean  @default(true)
  /// User-defined display order (lower = first). New items are prepended (min − 1).
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  snapshots     PriceSnapshot[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, sortOrder])
  @@index([awinFeedKey])
}

model Notification {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingId  String?
  tracking    PriceTracking? @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  kind        String         @default("PRICE_ALERT")
  title       String
  body        String
  /// Structured i18n for in-app UI (`title`/`body` stay English for email + web push).
  payload     Json?
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([userId, read, createdAt])
}

model PriceSnapshot {
  id         String        @id @default(uuid())
  trackingId String
  tracking   PriceTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  price      Decimal       @db.Decimal(12, 4)
  currency   String
  recordedAt DateTime      @default(now())

  @@index([trackingId, recordedAt])
}
