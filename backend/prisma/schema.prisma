// Prisma 7: connection URL is in prisma.config.ts (see `defineConfig` datasource).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String
  planTier             PlanTier           @default(FREE)
  paypalSubscriptionId String?            @unique
  /// Set on registration when the user accepts the Terms of Service (AGB).
  termsAcceptedAt      DateTime?
  /// Double opt-in: set when the user confirms the verification link (e-mail ownership).
  emailVerifiedAt            DateTime?
  /// SHA-256 hex of the raw token sent by e-mail; cleared after successful verification.
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  /// UI / transactional mail language (e.g. `de`, `en`); set at registration, used for verification & welcome e-mails.
  preferredLocale      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  trackings            PriceTracking[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
}

/// Web Push subscription (VAPID) — one row per browser/device endpoint.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Published pricing / PayPal subscription product (seeded + configurable via env)
model Plan {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  /// Price in cents per billing period (e.g. monthly net before VAT; UI adds VAT note)
  priceCents   Int
  currency     String  @default("EUR")
  paypalPlanId String
  /// null = unlimited trackings
  maxTrackings Int?
  sortOrder    Int     @default(0)
}

model PriceTracking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  /// Scraped product name (refreshed with price)
  productName   String
  /// Store / brand / site name when detectable
  companyName   String?
  /// User-facing label; when set, shown instead of scraped productName
  productNameOverride   String?
  /// User-facing label; when set, shown instead of scraped companyName
  companyNameOverride   String?
  /// How often automatic price checks run (minutes). Min 15, max 10080 (7d).
  recheckIntervalMinutes Int      @default(360)
  /// Notify once when price crosses down to this level or below (optional)
  alertBelowPrice Decimal? @db.Decimal(12, 4)
  /// Notify once when price crosses up to this level or above (optional)
  alertAbovePrice Decimal? @db.Decimal(12, 4)
  /// Email for price alerts on this product (plan-limited: 2 free, 10 Pro). Push + in-app stay unlimited.
  emailAlertsEnabled Boolean @default(false)
  lastPrice     Decimal? @db.Decimal(12, 4)
  currency      String   @default("EUR")
  lastCheckedAt DateTime?
  active        Boolean  @default(true)
  /// User-defined display order (lower = first). New items are prepended (min − 1).
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  snapshots     PriceSnapshot[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, sortOrder])
}

model Notification {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingId  String?
  tracking    PriceTracking? @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  kind        String         @default("PRICE_ALERT")
  title       String
  body        String
  /// Structured i18n for in-app UI (`title`/`body` stay English for email + web push).
  payload     Json?
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([userId, read, createdAt])
}

model PriceSnapshot {
  id         String        @id @default(uuid())
  trackingId String
  tracking   PriceTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  price      Decimal       @db.Decimal(12, 4)
  currency   String
  recordedAt DateTime      @default(now())

  @@index([trackingId, recordedAt])
}
