# Copy to frontend/.env (gitignored). Used by `npm start` / `npm run env` → environment.generated.ts
# Repo-root `.env` is loaded first, then this file (override). So PayPal can live only in the root `.env` next to docker-compose.
# Backend-only secrets (DATABASE_URL, JWT, …) stay in the root `.env` for the API.

# API base used by the SPA (ng serve → localhost:3000 if API runs on host)
NG_API_URL=http://localhost:3000/api

# Umami: optional. Use your own Umami “website” UUID — leave UMAMI_WEBSITE_ID empty to disable tracking (no default ID in builds).
UMAMI_HOST_URL=https://umami.showbk.com
# UMAMI_SCRIPT_URL=https://umami.showbk.com/script.js
UMAMI_WEBSITE_ID=

# PayPal buttons (must match API / PAYPAL_USE_SANDBOX). If the “wrong” id is set, the script uses the other as fallback.
PAYPAL_USE_SANDBOX=false
PAYPAL_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_ID=

# API / Prisma seed only (Pro: 3.99 €/mo net + 19% USt in app; 399¢/mo in DB)
PAYPAL_PRO_PLAN_ID=P-6TL7122718514241MNHCG5QQ
