# Copy to frontend/.env (gitignored). Used by `npm start` / `npm run env` → environment.generated.ts
# Backend secrets (DATABASE_URL, JWT, …) belong in the repo root .env for docker-compose / API — not required here for Angular.

# API base used by the SPA (ng serve → localhost:3000 if API runs on host)
NG_API_URL=http://localhost:3000/api

# Umami (same instance as ShowBK: https://umami.showbk.com — create a separate “website” in Umami for Pricefly and replace the ID)
UMAMI_HOST_URL=https://umami.showbk.com
# Optional override; default is UMAMI_HOST_URL + /script.js
# UMAMI_SCRIPT_URL=https://umami.showbk.com/script.js
UMAMI_WEBSITE_ID=14cabb5c-7310-487f-96a6-05ce09f6005e

# PayPal buttons (must match API / PAYPAL_USE_SANDBOX)
PAYPAL_USE_SANDBOX=false
PAYPAL_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_ID=
